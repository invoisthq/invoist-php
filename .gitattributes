# Normalise line endings; keep binary test data untouched.
* text=auto eol=lf
*.pdf binary
*.png binary
*.jpg binary

# Left out of the Packagist dist (GitHub's archive of a tag), so installing
# the library gets src/, the manifest, the README, CHANGELOG, LICENSE and
# SECURITY.md only.
/.gitattributes      export-ignore
/.gitignore          export-ignore
/.invoist-sdk.json   export-ignore
/phpcs.xml.dist      export-ignore
/phpstan.neon.dist   export-ignore
/phpunit.xml.dist    export-ignore
/scripts             export-ignore
/testdata            export-ignore
/tests               export-ignore
